{
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "tasks": {
    "enabled": true,
  },
  "toolbar": {
    "code_actions": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": false,
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500,
    },
  },
  // Programming Language settings
  "languages": {
    "Python": {
      "tab_size": 4,
      "preferred_line_length": 88,
      "format_on_save": "on",
      "soft_wrap": "preferred_line_length",
      "language_servers": ["ty", "ruff"],
    },
    "Rust": {
      "tab_size": 4,
      "preferred_line_length": 88,
      "format_on_save": "on",
      "soft_wrap": "preferred_line_length",
      "language_servers": ["rust-analyzer"],
    },
    "JSON": {
      "format_on_save": "on",
    },
    "YAML": {
      "format_on_save": "on",
    },
  },
  // AI Settings
  "language_models": {
    "ollama": {
      "context_window": 32000,
    },
  },
  "edit_predictions": {
    "mode": "eager",
    "ollama": {
      "max_output_tokens": 128,
      "model": "gemma4-dev:e4b",
    },
    "provider": "ollama",
  },
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "ollama",
      "model": "gemma4-dev:26b",
    },
    "favorite_models": [
      {
        "provider": "ollama",
        "model": "qwen3.6-dev:35b",
      },
      {
        "provider": "ollama",
        "model": "gemma4-dev:e4b",
      },
      {
        "provider": "ollama",
        "model": "gemma4-dev:26b",
      },
    ],
    "model_parameters": [],
  },
}
