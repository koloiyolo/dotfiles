{
  "language_models": {
    "ollama": {
      "context_window": 32000
    }
  },
  "edit_predictions": {
    "mode": "subtle",
    "sweep": {
      "privacy_mode": true
    },
    "ollama": {
      "max_output_tokens": 32,
      "model": "gemma3-dev:4b"
    },
    "provider": "ollama"
  },
  "vim_mode": false,
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": true
  },
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "ollama",
      "model": "qwen3.5-dev:4b"
    },
    "favorite_models": [
      {
        "provider": "ollama",
        "model": "qwen3.5-dev:4b"
      },
      {
        "provider": "ollama",
        "model": "qwen3.5-dev:9b"
      },
      {
        "provider": "ollama",
        "model": "gemma3-dev:4b"
      }
    ],
    "model_parameters": []
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "tab_size": 4,
  "preferred_line_length": 88,
  "format_on_save": "on",
  "soft_wrap": "preferred_line_length",
  "languages": {
    "Python": {
      "language_servers": ["ty", "!basedpyright", "..."]
    },
    "JSON": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "YAML": {
      "tab_size": 2,
      "preferred_line_length": 176,
      "format_on_save": "on"
    }
  }
}
