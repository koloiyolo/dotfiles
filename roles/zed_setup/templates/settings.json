{
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "tasks": {
    "enabled": true
  },
  "toolbar": {
    "code_actions": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": false,
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "languages": {
    "Python": {
      "tab_size": 4,
      "preferred_line_length": 88,
      "format_on_save": "on",
      "soft_wrap": "prefer_line",
      "language_servers": ["ty", "ruff"]
    },
    "Rust": {
      "tab_size": 4,
      "preferred_line_length": 88,
      "format_on_save": "on",
      "soft_wrap": "prefer_line",
      "language_servers": ["rust-analyzer"]
    },
    "JSON": {
      "format_on_save": "on"
    },
    "YAML": {
      "format_on_save": "on"
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    }
  },
  "edit_predictions": {
    "open_ai_compatible_api": {
      "model": "llama.cpp",
      "api_url": "http://127.0.0.1:8080/v1"
    },
    "mode": "eager",
    "provider": "open_ai_compatible_api"
  },
  "agent": {
    "favorite_models": [
      {
        "provider": "llama.cpp",
        "model": "unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_M",
        "enable_thinking": true
      }
    ],
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\s+diff(\\s|$)"
            },
            {
              "pattern": "^cargo\\s+clippy(\\s|$)"
            },
            {
              "pattern": "^tree(\\s|$)"
            }
          ]
        }
      }
    },
    "dock": "right",
    "sidebar_side": "right",
    "default_profile": "write",
    "inline_assistant_use_streaming_tools": false,
    "model_parameters": []
  }
}
